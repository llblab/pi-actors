{
  "async": true,
  "imports": {
    "subagent": "swarm/subagent-prompt"
  },
  "args": [
    "prompts:array",
    "model:string",
    "thinking:string",
    "tools:string",
    "output_format:string"
  ],
  "defaults": {
    "thinking": "off",
    "tools": "",
    "output_format": "Concise Markdown with assumptions and next actions."
  },
  "repeat": "{prompts.length}",
  "parallel": true,
  "failure": "branch",
  "template": {
    "name": "subagent",
    "values": {
      "prompt": "{prompts[index]}",
      "model": "{model}",
      "thinking": "{thinking}",
      "tools": "{tools}",
      "output_format": "{output_format}"
    }
  }
}
