{
  "async": true,
  "args": [
    "repo:path",
    "command:enum(play,pause,resume,toggle,next,previous,stop,status)",
    "source:string",
    "loop:bool",
    "volume:int",
    "player:enum(auto,mpv,afplay,ffplay,cvlc,play,wmp)",
    "state_dir:path"
  ],
  "defaults": {
    "repo": "~/.pi/agent/extensions/pi-actors",
    "command": "play",
    "loop": "true",
    "volume": "70",
    "player": "auto"
  },
  "control": [
    "play",
    "pause",
    "resume",
    "toggle",
    "next",
    "previous",
    "stop",
    "status"
  ],
  "template": "{repo}/scripts/music-player.mjs {command} {source} {loop} {volume} {player} {state_dir}"
}
